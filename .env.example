# robotframework-chat environment configuration
# Copy to .env and edit before running: cp .env.example .env
#
# Variables are loaded by:
#   - Makefile        : -include .env + export
#   - CI shell scripts: set -a; source .env; set +a
#   - pytest          : python-dotenv session fixture (override=False)
#   - suite_config.py : overlays onto config/test_suites.yaml

# ── Docker / App Image ───────────────────────────────────────────────
# App image version (informational; not consumed by docker-compose).
# docker compose always builds from local source via `build: .`.
# To run a pre-built image: docker pull ghcr.io/tkarcheski/robotframework-chat:1.5.2
APP_VERSION=1.5.2

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=rfc
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rfc
POSTGRES_PORT=5433
# Container-internal PostgreSQL port (rarely needs changing)
POSTGRES_INTERNAL_PORT=5432
# DATABASE_HOST is used to construct DATABASE_URL in CI environments.
# Locally it is always localhost.
DATABASE_HOST=localhost

# ── Superset ──────────────────────────────────────────────────────────
SUPERSET_SECRET_KEY=generate-a-random-secret-here
SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=changeme
SUPERSET_ADMIN_EMAIL=admin@rfc.local

# ── RF Metrics Dashboard ───────────────────────────────────────────
METRICS_PORT=8089
# How often (seconds) to regenerate metrics from output.xml files
METRICS_REFRESH_INTERVAL=300

# ── Test Runner ──────────────────────────────────────────────────────
# DATABASE_URL tells the test harness to archive to PostgreSQL.
# Construct from the variables above.
# NOTE: When running inside docker-compose, the app service auto-sets
# DATABASE_URL=postgresql://rfc:changeme@postgres:5432/rfc
# (uses internal Docker DNS). The value below is for host-side usage.
DATABASE_URL=postgresql://rfc:changeme@localhost:5433/rfc

# ── LLM Provider ─────────────────────────────────────────────────────
# Provider selection: "ollama" (default), "openai", or "vllm"
LLM_PROVIDER=ollama

# Ollama endpoint for LLM tests. On the same host this is localhost; point it
# at a LAN box (e.g. http://gpu-host:11434) to offload generation. NOT a secret on a
# trusted LAN, but never expose an Ollama endpoint to the public internet — it
# is unauthenticated.
OLLAMA_ENDPOINT=http://localhost:11434

# Default model under test. Must already be pulled on the endpoint
# (`ollama pull qwen3:32b`). A large model on modest hardware is the #1 cause
# of test timeouts — start smaller (e.g. qwen3:8b) if every test is FAILING.
DEFAULT_MODEL=qwen3:32b

# OLLAMA_TIMEOUT — per-request HTTP budget in seconds for a single Ollama
# `generate` call (default 5400 = 90 min). This is the ceiling for ONE LLM
# response, including cold model load. Slow/local hardware can need the full
# budget for a large model's first call; raise it if you see ReadTimeout in
# logs. The Robot `Test Timeout` in each suite is kept >= this value so Robot
# never aborts a request the HTTP client is still legitimately awaiting. See
# CLAUDE.md § "Ollama / .env setup" for the full tuning guide.
OLLAMA_TIMEOUT=5400

# ── Node Discovery ───────────────────────────────────────────────────
# OpenAI / OpenAI-compatible API settings (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=5400

# vLLM OpenAI-compatible server (used when LLM_PROVIDER=vllm). vLLM accepts any
# bearer token, so VLLM_API_KEY is optional (defaults to a dummy "EMPTY").
VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=

# ── OpenRouter (issue #507) ──────────────────────────────────────────
# One-time $10 credit purchase unlocks 1,000 req/day on the ":free" model
# pool (20 RPM); leave unset to skip the provider (skip-and-log).
# OPENROUTER_API_KEY=
# Groq free tier — sign up at https://console.groq.com (llama-3.1-8b-instant, 30 RPM)
# GROQ_API_KEY=
# Cerebras free tier — sign up at https://cloud.cerebras.ai (1M tokens/day, 8K ctx)
# CEREBRAS_API_KEY=
# Google AI Studio free tier — key from https://aistudio.google.com (1,500 req/day Flash)
# GOOGLE_AI_STUDIO_API_KEY=

# ── Provider daily budget counter (issue #515) ───────────────────────
# Runtime per-provider/per-UTC-day request counter. The scheduler hard-stops
# dispatching new (model, suite) jobs once a provider hits its
# max_requests_per_day, counting actual API calls (incl. retries/429s), not
# just the upfront estimate. Defaults to .rfc_provider_budget.json at the repo
# root; override the path here. Delete the file to reset the day's count early.
# RFC_PROVIDER_BUDGET_FILE=

# ── Node Discovery ───────────────────────────────────────────────────
# Comma-separated list of Ollama node hostnames for monitoring.
# With host networking (default Docker setup), localhost and LAN names
# resolve directly.  With bridge networking, localhost is auto-rewritten
# to host.docker.internal.
# Leave empty to use the nodes list from config/test_suites.yaml.
OLLAMA_NODES_LIST=localhost

# Legacy node discovery (scripts/discover_ollama.py).
# OLLAMA_NODES uses host:port format; OLLAMA_SUBNET uses CIDR notation.
# OLLAMA_NODES=host1:11434,host2:11434
# OLLAMA_SUBNET=192.168.1.0/24

# Override the hostname recorded in test results (default: platform.node()).
# RFC_HOSTNAME=my-machine

# ── CEO Agent Pipeline ──────────────────────────────────────────────
# Optional CEO-specific provider override (ollama/openai). When unset, the
# CEO pipeline keeps legacy OpenAI behavior if OPENAI_API_KEY is configured
# and LLM_PROVIDER is still the repo default 'ollama'.
# CEO_LLM_PROVIDER=openai

# Comma-separated list of 3+ model names for multi-LLM grading (tier:3)
CEO_GRADER_MODELS=qwen2:latest,phi3:latest,gemma2:latest

# Max tokens for CEO pipeline stages (default: 4096)
CEO_MAX_TOKENS=4096

# ── Creativity Joke Judging (issue #260) ────────────────────────────
# Comma-separated list of 3+ judge models distinct from the generation
# model. `Creative.Grade Joke` requires this to avoid self-grading bias;
# tests skip (ROBOT_SKIP_EXECUTION) when unset.
CREATIVITY_GRADER_MODELS=qwen2:latest,phi3:latest,gemma2:latest

# ── Agentic Coding Prose Graders (issue #289) ───────────────────────
# Comma-separated list of 3+ distinct judge models for tier:3 prose
# grading; must not include the generation model (no self-grading).
# Tier:3 prose tests skip (ROBOT_SKIP_EXECUTION) when unset.
AGENT_PROSE_GRADER_MODELS=phi4:14b,llama3.1:latest,gemma2:latest

# Web search API endpoint for market/patent research enrichment
WEB_SEARCH_ENDPOINT=

# Web cache TTL in seconds (default: 86400 = 24 hours)
WEB_CACHE_TTL=86400

# ── Hugging Face ──────────────────────────────────────────────────────
# Token for Hugging Face API (datasets library, model downloads).
# Only "Read" (public) access is required — no write/org permissions needed.
# Create at: https://huggingface.co/settings/tokens
# Used by: scripts/import_hf_dataset.py, rfc.huggingface_keywords
HF_TOKEN=

# ── Markdown Audit (OpenCode) ────────────────────────────────────────
# Model for markdown audit (default: ollama/qwen3-coder:30b-a3b-q4_K_M)
AUDIT_MODEL=

# Base branch for diff-based reviews (default: auto-detected main/master)
# BASE_BRANCH=main

# Number of recent commits to consider for markdown audit (default: 20)
# COMMIT_DEPTH=20

# ── Superset Remote Deploy (ci/deploy.sh) ────────────────────────────
# Required only for remote Superset deployment via CI.
# SUPERSET_DEPLOY_HOST=superset.example.com
# SUPERSET_DEPLOY_USER=deploy
# SUPERSET_DEPLOY_PATH=/opt/superset


# ── Backups Repo (ci/backup_push.sh, used by `make superset-export`) ─
# `make superset-export` clones BACKUPS_REPO_URL into BACKUPS_DIR on demand,
# commits the Superset export + pg_dump, and pushes to main. If the clone or
# push fails the artifacts stay local and the export still succeeds.
# BACKUPS_DIR=backups
# BACKUPS_REPO_URL=git@github.com:tkarcheski/robotframework-chat-backups.git


# ── Answer Cache (#522) ──────────────────────────────────────────────
# Redis-backed memoization of client.generate() for dev-loop re-runs.
# OPT-IN: leave disabled for measurement/grading runs — a cache hit replays
# a past answer, which is wrong when you mean to measure current behaviour.
# Redis connection. Default uses db 1 — NOT Superset's db 0.
# REDIS_URL=redis://localhost:6379/1
# Master switch: 1 enables caching; anything else (default) leaves it off.
# ANSWER_CACHE_ENABLED=0
# Cache entry lifetime in seconds (default 604800 = 7 days).
# ANSWER_CACHE_TTL_SECONDS=604800
# Namespace/version string; bump to bust the entire cache on a schema change.
# ANSWER_CACHE_VERSION=v1
# 1 caches non-deterministic requests (temp>0, no seed) too; default off so
# only reproducible requests (temperature==0 OR seed set) are cached.
# ANSWER_CACHE_NONDETERMINISTIC=0
# Finite Redis timeouts in seconds (default 1.0 each): a down/unresponsive
# cache degrades to passthrough fast instead of hanging the first lookup.
# ANSWER_CACHE_CONNECT_TIMEOUT=1.0
# ANSWER_CACHE_SOCKET_TIMEOUT=1.0
